# Firebase project config — copy this file to .env and fill in the real
# values from Firebase Console → Project Settings → Your Apps → SDK setup.
# .env is gitignored and must never be committed.
#
# These are used by:
#   - js/firebase-config.js (bundled into the browser build by Vite —
#     VITE_-prefixed vars are inlined at build time, not secret at runtime)
#   - seed.js, seed-pathways.js, init-active-flag.js (one-off Node scripts)
#
# On Vercel: set the same names under Project Settings → Environment
# Variables (this repo is hosted on Vercel; Firebase is backend-only here).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
