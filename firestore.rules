rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAnonymous() {
      return request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // A real club member: signed in with email/password (not the anonymous
    // account guest login uses) AND has a users/{uid} doc. users docs can
    // only be created by an admin or the console, never self-created.
    function isMember() {
      return signedIn() && !isAnonymous()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn() && !isAnonymous() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin','core'];
    }

    // A primary admin is an admin/core user that ALSO carries the
    // isPrimaryAdmin flag. Only primary admins can approve
    // primary-admin promotions/demotions.
    function isPrimaryAdmin() {
      return isAdmin() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isPrimaryAdmin == true;
    }

    // A guest who redeemed a valid OTP. The redeemGuestOtp Cloud Function
    // sets these custom claims on their anonymous account; a client can
    // never set claims itself. guestExp is the OTP's expiry in ms.
    function isGuest() {
      return signedIn() && request.auth.token.guest == true
        && request.time.toMillis() < request.auth.token.guestExp;
    }

    function guestTokenId() {
      return request.auth.token.tokenId;
    }

    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // True once TWO DISTINCT admins have approved a delete/reset request
    // for this exact document, via the pendingActions collection. Used
    // to gate every delete/reset button in the admin dashboard.
    function dualApproved(col, id) {
      let pa = get(/databases/$(database)/documents/pendingActions/$('del_' + col + '_' + id));
      return pa.data.kind == 'delete'
        && pa.data.status == 'approved'
        && pa.data.approvals.size() >= 2;
    }

    // Like dualApproved, but the approval is used up: the same batch must
    // flip the pendingActions doc to 'executed', so one approval can't be
    // replayed later (used for the leaderboard reset, which has no delete
    // to make it naturally one-shot).
    function dualApprovedOnce(col, id) {
      let path = /databases/$(database)/documents/pendingActions/$('del_' + col + '_' + id);
      return dualApproved(col, id) && getAfter(path).data.status == 'executed';
    }

    // Same idea, but for a specific field CHANGE on a document (used so
    // the isPrimaryAdmin flag can only move to `newVal` once 2 primary
    // admins signed off on exactly that change).
    function dualApprovedPrimary(uid, newVal) {
      let pa = get(/databases/$(database)/documents/pendingActions/$('pa_' + uid));
      return pa.data.kind == 'primaryAdminChange'
        && pa.data.status in ['approved', 'executed']
        && pa.data.approvals.size() >= 2
        && pa.data.newValue == newVal;
    }

    // ── Public read, admin write, dual-approval delete ──────────
    match /events/{id} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin() && dualApproved('events', id);
    }
    match /gallery/{id} {
      // Photos marked members-only must not leak to visitors.
      allow read: if resource.data.visibility == 'public' || isMember() || isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isAdmin() && dualApproved('gallery', id);
    }
    match /videos/{id} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin() && dualApproved('videos', id);
    }
    match /members/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /pathways/{id}  { allow read: if true; allow write: if isAdmin(); }

    // ── Members ──────────────────────────────────────────────
    match /users/{uid} {
      // Members need the full list for the leaderboard / mentions.
      // Guests and bare anonymous sign-ins get nothing.
      allow read: if isMember();

      // Accounts are provisioned by admins or the console, never by the
      // user themselves (self-create is how role:'admin' used to leak).
      allow create: if isAdmin()
        && (!('isPrimaryAdmin' in request.resource.data) || request.resource.data.isPrimaryAdmin == false);

      // A member may only touch their own bookkeeping fields. Everything
      // else (role, attendance, speeches, badges, ...) is admin-only.
      allow update: if request.auth.uid == uid && isMember()
        && onlyChanges(['lastLogin', 'pathwayKey', 'seenBadgeIds', 'lastKnownRank', 'lastSeenCommonNotifId']);

      // An admin can update anyone's profile, UNLESS the write touches
      // isPrimaryAdmin, in which case that specific change must already be
      // dual-approved by two primary admins.
      allow update: if isAdmin()
        && ( !('isPrimaryAdmin' in request.resource.data)
             || ( 'isPrimaryAdmin' in resource.data && request.resource.data.isPrimaryAdmin == resource.data.isPrimaryAdmin )
             || dualApprovedPrimary(uid, request.resource.data.isPrimaryAdmin) );

      // Deleting a member account is a "delete button" too.
      allow delete: if isAdmin() && dualApproved('users', uid);
    }

    match /notifications/{id} {
      allow read: if isAdmin()
        || (isMember() && resource.data.type == 'common')
        || (isMember() && resource.data.type == 'personal' && resource.data.targetUid == request.auth.uid);

      allow create, update: if isAdmin();

      // Members raise personal notifications for badges they earned and
      // for @mentions in chat. Keep them to that exact shape.
      allow create: if isMember()
        && request.resource.data.keys().hasOnly(['type', 'targetUid', 'title', 'body', 'read', 'createdAt'])
        && request.resource.data.type == 'personal'
        && request.resource.data.read == false
        && request.resource.data.targetUid is string
        && request.resource.data.title is string && request.resource.data.title.size() <= 200
        && request.resource.data.body is string && request.resource.data.body.size() <= 500;

      // The recipient marks their own personal notification as read.
      allow update: if isMember()
        && resource.data.type == 'personal'
        && resource.data.targetUid == request.auth.uid
        && onlyChanges(['read']);

      allow delete: if isAdmin() && dualApproved('notifications', id);
    }

    // Doc id is `${eventId}_${speakerUid}_${giverUid}` for members and
    // `${eventId}_${speakerUid}_guest_${tokenId}` for guests, so each giver
    // has exactly one (overwritable) feedback doc per speaker per event
    // and can never write someone else's.
    function validFeedback() {
      let d = request.resource.data;
      return d.eventId is string && d.speakerUid is string
        && d.ratings is map
        && (!('comment' in d) || (d.comment is string && d.comment.size() <= 2000));
    }

    match /feedback/{id} {
      allow read: if isMember() || isAdmin();

      allow create, update: if isMember() && validFeedback()
        && request.resource.data.giverUid == request.auth.uid
        && !('isGuest' in request.resource.data)
        && id == request.resource.data.eventId + '_' + request.resource.data.speakerUid + '_' + request.auth.uid
        && (resource == null || resource.data.giverUid == request.auth.uid);

      allow create, update: if isGuest() && validFeedback()
        && request.resource.data.isGuest == true
        && request.resource.data.tokenId == guestTokenId()
        && request.resource.data.eventId == request.auth.token.eventId
        && request.resource.data.giverUid == request.auth.uid
        && id == request.resource.data.eventId + '_' + request.resource.data.speakerUid + '_guest_' + guestTokenId();

      allow delete: if isAdmin(); // cascade-child of an already dual-approved event delete
    }

    match /votingSessions/{id} {
      allow read:  if isMember() || isGuest();
      allow create, update: if isAdmin();
      allow delete: if isAdmin() && dualApproved('votingSessions', id);
    }

    // Ballots are written only by the castVote Cloud Function, which checks
    // eligibility and enforces one vote per voter per session.
    match /votes/{id} {
      allow read: if isAdmin();
      allow create, update: if false;
      allow delete: if isAdmin();
    }
    match /voteRecords/{id} {
      // A voter can check whether they have voted (doc id starts with their
      // uid for members, `guest_<tokenId>` for guests).
      allow read: if isAdmin()
        || (isMember() && id.matches(request.auth.uid + '_.*'))
        || (isGuest() && id.matches('guest_' + guestTokenId() + '_.*'));
      allow create, update: if false;
      allow delete: if isAdmin();
    }

    // Guest OTPs. Only admins can list them; a guest can read only the
    // token they redeemed. OTP checking happens in redeemGuestOtp.
    match /guestTokens/{id} {
      allow read: if isAdmin() || (isGuest() && id == guestTokenId());
      allow create, update: if isAdmin();
      allow delete: if isAdmin(); // cascade-child of event delete / voting session delete
    }

    match /guestExperienceFeedback/{id} {
      allow create, update: if isGuest()
        && id == 'guest_' + guestTokenId()
        && request.resource.data.tokenId == guestTokenId()
        && (!('comment' in request.resource.data)
            || (request.resource.data.comment is string && request.resource.data.comment.size() <= 2000));
      allow read: if isAdmin() || (isGuest() && id == 'guest_' + guestTokenId());
      allow delete: if isAdmin();
    }

    // Every settings doc needs an admin. The 'leaderboard' doc (the
    // "Clear Leaderboard" button) additionally needs a fresh 2-admin
    // approval that is consumed by the same write.
    match /settings/{doc} {
      allow read: if isMember() || isAdmin();
      allow create, update: if isAdmin() && (doc != 'leaderboard' || dualApprovedOnce('settings', doc));
    }

    match /clubDocs/{id} {
      allow read: if isMember() || isAdmin();
      allow create, update: if isAdmin();
      allow delete: if false; // Documentation cannot be deleted
    }

    match /chatMessages/{id} {
      allow read: if isMember();
      // Ids must be Firestore auto-ids: the chat UI puts them in onclick="".
      allow create: if isMember()
        && id.matches('^[A-Za-z0-9]{20}$')
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 4000
        && !('deleted' in request.resource.data);
      // The sender can edit the text or soft-delete their own message, but
      // never change who sent it. Admins can only soft-delete.
      allow update: if isMember()
        && resource.data.senderUid == request.auth.uid
        && onlyChanges(['text', 'editedAt', 'deleted', 'deletedAt', 'deletedBy', 'deletedByName'])
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 4000;
      allow update: if isAdmin()
        && onlyChanges(['deleted', 'deletedAt', 'deletedBy', 'deletedByName']);
      allow delete: if isAdmin();
    }

    // Chat reactions live in a per-message subcollection, but are read
    // back with a collectionGroup() query. That requires the recursive
    // {path=**} wildcard form; a nested match under chatMessages/{id}
    // does NOT satisfy a collectionGroup read.
    match /{path=**}/reactions/{uid} {
      allow read: if isMember();
      allow create, update, delete: if isMember()
        && request.auth.uid == uid;
    }

    // ── Dual-admin approval workflow ─────────────────────────────
    // Every "dangerous" action (delete X, clear leaderboard, restore a
    // backup, promote/demote a primary admin) is requested here first.
    // A doc only becomes usable by the rules above once TWO DISTINCT
    // qualifying admins are in its `approvals` array and its `status`
    // is 'approved'.

    // A fresh request: opened by the caller alone, starting at 'pending'.
    // The doc id must name the exact target, because the rules above and
    // the Cloud Function look the approval up by id. primaryAdminChange
    // requests can only be OPENED by a primary admin (the second approval
    // must also come from one).
    function validNewRequest(paId) {
      let d = request.resource.data;
      return isAdmin()
        && d.requestedBy == request.auth.uid
        && d.approvals.size() == 1
        && d.approvals[0] == request.auth.uid
        && d.status == 'pending'
        && (d.kind != 'primaryAdminChange' || (isPrimaryAdmin() && paId == 'pa_' + d.targetUid))
        && (d.kind != 'delete' || paId == 'del_' + d.targetCollection + '_' + d.targetDocId);
    }

    match /pendingActions/{paId} {
      allow read: if isAdmin();

      allow create: if validNewRequest(paId);

      // A second admin approves: only `approvals` and `status` may change,
      // with exactly one new, distinct uid appended; status may flip
      // pending -> approved once 2 distinct approvers are present. The
      // request itself (target, new value, kind) is frozen.
      // Once approved, the only change allowed is marking it
      // 'executed' or 'failed' after the action has run.
      allow update: if isAdmin() &&
        (
          ( resource.data.status == 'pending'
            && onlyChanges(['approvals', 'status'])
            && request.resource.data.approvals.size() == resource.data.approvals.size() + 1
            && request.auth.uid in request.resource.data.approvals
            && !(request.auth.uid in resource.data.approvals)
            && request.resource.data.approvals.hasAll(resource.data.approvals)
            && (resource.data.kind != 'primaryAdminChange' || isPrimaryAdmin())
            && request.resource.data.status == (request.resource.data.approvals.size() >= 2 ? 'approved' : 'pending')
          )
          ||
          ( resource.data.status == 'approved'
            && request.resource.data.status in ['executed', 'failed']
            && onlyChanges(['status', 'executedAt', 'error', 'failedAt'])
          )
          ||
          // A finished (executed/failed) request can be reopened from scratch.
          ( resource.data.status in ['executed', 'failed'] && validNewRequest(paId) )
        );

      allow delete: if isPrimaryAdmin();
    }

    match /rateLimits/{id} {
      allow read, write: if false; // Cloud Functions only
    }

    match /auditLog/{id} {
      allow read: if isPrimaryAdmin();
      allow write: if false; // only written by Cloud Functions (Admin SDK bypasses rules)
    }
  }
}
